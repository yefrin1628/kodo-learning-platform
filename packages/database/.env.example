DATABASE_URL="postgresql://kodo_dev:tu_password_local@127.0.0.1:5432/kodo_dev?schema=public"
# En local no hay pooler (PgBouncer/Neon) que distinga conexión pooled vs
# directa, así que apunta a la misma base — en producción, DATABASE_URL usa
# el pooler de Neon y DATABASE_URL_UNPOOLED la conexión directa que
# requieren las migraciones (ver directUrl en schema.prisma).
DATABASE_URL_UNPOOLED="postgresql://kodo_dev:tu_password_local@127.0.0.1:5432/kodo_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://kodo_dev:tu_password_local@127.0.0.1:5432/kodo_shadow?schema=public"
