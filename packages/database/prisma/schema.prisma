generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Dedicated, disposable database used by `prisma migrate dev`/`diff` to
  // compute schema diffs. Must NEVER point at DATABASE_URL itself — doing
  // that once corrupted kodo_dev's own _prisma_migrations bookkeeping.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  // Neon's pooled connection (DATABASE_URL, used by the app at runtime) goes
  // through PgBouncer in transaction mode, which doesn't reliably support
  // the DDL/prepared-statement patterns `prisma migrate` needs. `directUrl`
  // is Prisma's own mechanism for this exact split: `migrate`/`db push`
  // commands use it automatically, the generated Client at runtime still
  // uses `url` above — unset locally (no pooler in dev), only meaningful in
  // production where DATABASE_URL_UNPOOLED exists (Neon's Vercel
  // integration provisions both).
  directUrl         = env("DATABASE_URL_UNPOOLED")
}

// ===================== Enums =====================

enum CourseType {
  PROGRAMMING
  LANGUAGE
}

enum Difficulty {
  FACIL
  NORMAL
  DIFICIL
  DESAFIO
}

enum ExerciseType {
  CHOICE
  TRUE_FALSE
  FILL
  TYPE_ANSWER
  ORDER
  TRANSLATE
  PREDICT
  BUG
  RUN
  LISTEN
  MATCH
  SPEAK
  CONVO
}

enum XPReason {
  EXERCISE_CORRECT
  LESSON_COMPLETE
  PROJECT_COMPLETE
  MODULE_COMPLETE
  COURSE_COMPLETE
  DAILY_GOAL
  DAILY_FIRST
  REVIEW
  PRACTICE
  CEFR_LEVEL_UP
  ACHIEVEMENT
  CHALLENGE_COMPLETE
}

enum PlanInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

// ===================== Users =====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userProfile       UserProfile?
  userStats         UserStats?
  streak            Streak?
  courseProgress    UserCourseProgress[]
  lessonProgress    LessonProgress[]
  exerciseProgress  ExerciseProgress[]
  xpTransactions    XPTransaction[]
  achievements      UserAchievement[]
  challengeProgress UserChallengeProgress[]
  vocabularyReviews VocabularyReview[]
  subscriptions     Subscription[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  inventory         UserInventory[]
  usernameHistory   UsernameHistory[]
  following         Follow[]                 @relation("Following")
  followers         Follow[]                 @relation("Followers")
  blocksMade        Block[]                  @relation("BlocksMade")
  blocksReceived    Block[]                  @relation("BlocksReceived")
  reportsMade       Report[]                 @relation("ReportsMade")
  reportsReceived   Report[]                 @relation("ReportsReceived")
  notifications     Notification[]           @relation("NotificationRecipient")
  notificationsCaused Notification[]         @relation("NotificationActor")

  @@map("users")
}

/// Identidad pública: quién es el usuario (no cuánto sabe ni cuánto tiene).
model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique
  displayName String
  avatarUrl   String?
  bio         String?  @db.VarChar(160)
  // Cooldown de 30 días entre cambios de username — se compara contra esto,
  // no se guarda un contador aparte. Null = nunca se ha cambiado.
  usernameChangedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Onboarding quiz result — server-authoritative so it survives a new
  // device/browser instead of living only in localStorage (was the root
  // cause of returning users seeing the onboarding flow again on koda.school
  // after localStorage on the .vercel.app origin never carried over).
  onboardingCompleted Boolean @default(false)
  goalMin             Int     @default(15)
  product             String  @default("code")

  @@map("user_profiles")
}

/// Aprendizaje + economía: todo lo que cambia mientras el usuario aprende.
model UserStats {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         Int      @default(1)
  xp            Int      @default(0)
  gems          Int      @default(30)
  hearts        Int      @default(5)
  activeProduct String   @default("code") // "code" | "lang"
  dailyGoalMinutes Int   @default(15)
  updatedAt     DateTime @updatedAt

  @@map("user_stats")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Auditoría de cambios de @username — no se usa para resolver identidad en
/// caliente (username actual siempre vive en UserProfile), solo para poder
/// investigar abuso/soporte ("¿quién tenía este username antes?").
model UsernameHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username  String
  changedAt DateTime @default(now())

  @@index([userId])
  @@map("username_history")
}

// ===================== Social =====================

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
  @@map("follows")
}

/// El bloqueo tiene prioridad sobre cualquier otra interacción social —
/// ver reglas aplicadas en social.service.ts (búsqueda, follow, perfiles,
/// notificaciones).
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// Deliberadamente sigue funcionando aunque exista un Block entre las
/// partes — bloquear a alguien nunca debe impedir que te reporten.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User     @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime @default(now())

  @@index([reportedId, createdAt])
  @@map("reports")
}

enum NotificationType {
  NEW_FOLLOWER
  ACHIEVEMENT_UNLOCKED
  LEVEL_UP
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  actorId   String?
  actor     User?             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// ===================== Courses =====================

model Course {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String
  type        CourseType
  language    String // e.g. "js", "html", "en", "fr" — matches frontend course ids
  level       String? // e.g. "A1", "Principiante"
  colorHex    String?
  flagEmoji   String?
  isPublished Boolean    @default(false)
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  units          Unit[]
  courseProgress UserCourseProgress[]
  vocabulary     Vocabulary[]

  @@map("courses")
}

/// Course -> Unit -> Lesson -> Exercise. `key` es el id del módulo/unidad tal
/// como existe hoy en el frontend (index.html), para poder reimportar el
/// contenido de forma idempotente sin duplicar filas.
model Unit {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  key       String
  title     String
  emoji     String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@unique([courseId, key])
  @@index([courseId])
  @@map("units")
}

model Lesson {
  id             String   @id @default(cuid())
  unitId         String
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  key            String   @unique // id de la lección en el frontend, p.ej. "js-1"
  title          String
  icon           String?
  order          Int
  isProject      Boolean  @default(false)
  introHeading   String?
  introBody      String?
  introCode      String?
  introCodeLang  String?
  introAudioText String?
  baseXP         Int      @default(20)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  exercises Exercise[]
  project   Project?
  progress  LessonProgress[]

  @@index([unitId])
  @@map("lessons")
}

model Project {
  id                String   @id @default(cuid())
  lessonId          String   @unique
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  estimatedMinutes  Int?
  rewardXP          Int      @default(100)
  createdAt         DateTime @default(now())

  @@map("projects")
}

model Exercise {
  id            String       @id @default(cuid())
  lessonId      String
  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type          ExerciseType
  difficulty    Difficulty   @default(NORMAL)
  order         Int
  prompt        String? // null for types like `speak` whose primary content is a target phrase, not a question
  explanation   String?
  // Structured data specific to the exercise type (code snippets, word banks,
  // match pairs, starter/must/expect for `run`, target phrase for `speak`, etc.)
  content       Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  options ExerciseOption[]
  progress ExerciseProgress[]

  @@unique([lessonId, order])
  @@map("exercises")
}

model ExerciseOption {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean  @default(false)
  order      Int

  @@unique([exerciseId, order])
  @@map("exercise_options")
}

// ===================== Progress =====================

model UserCourseProgress {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  percentComplete  Int       @default(0)
  lessonsCompleted Int       @default(0)
  startedAt        DateTime  @default(now())
  lastActivityAt   DateTime  @default(now())
  completedAt      DateTime?

  @@unique([userId, courseId])
  @@map("user_course_progress")
}

model LessonProgress {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed     Boolean   @default(false)
  accuracy      Int       @default(0)
  perfect       Boolean   @default(false)
  attemptsCount Int       @default(0)
  xpEarned      Int       @default(0)
  completedAt   DateTime?
  lastAttemptAt DateTime  @default(now())

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

/// Intento a nivel de ejercicio individual — la granularidad que permitirá
/// al backend validar XP/recompensas sin confiar en lo que envíe el cliente.
model ExerciseProgress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId     String
  exercise       Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  attempts       Int       @default(0)
  correctAnswers Int       @default(0)
  mistakes       Int       @default(0)
  completed      Boolean   @default(false) // ever answered correctly at least once
  lastAttemptAt  DateTime  @default(now())

  @@unique([userId, exerciseId])
  @@map("exercise_progress")
}

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    XPReason
  lessonId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("xp_transactions")
}

model Streak {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  current        Int      @default(0)
  best           Int      @default(0)
  shields        Int      @default(0)
  lastActiveDate String? // YYYY-MM-DD
  weekXp         Int      @default(0)
  weekKey        String?
  updatedAt      DateTime @updatedAt

  @@map("streaks")
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "html-master"
  name        String
  description String
  icon        String
  rewardXp    Int      @default(50)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  xpAwarded     Int         @default(0) // snapshot at unlock time, independent of later catalog changes
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ===================== Challenges =====================

model Challenge {
  id         String   @id @default(cuid())
  key        String   @unique
  title      String
  icon       String
  metric     String // 'lessons_completed' | 'xp_earned' | 'exercises_answered' | 'streak_maintained'
  goal       Int
  rewardXp   Int      @default(0)
  rewardGems Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  progress UserChallengeProgress[]

  @@map("challenges")
}

model UserChallengeProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD — challenges reset daily by definition, not by a cron job
  progress    Int       @default(0)
  claimed     Boolean   @default(false)
  claimedAt   DateTime?

  @@unique([userId, challengeId, date])
  @@map("user_challenge_progress")
}

// ===================== Vocabulary / SRS =====================

model Vocabulary {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  word            String
  translation     String
  emoji           String?
  exampleSentence String?
  audioLang       String? // e.g. "en-US", "fr-FR"
  createdAt       DateTime @default(now())

  reviews VocabularyReview[]

  @@unique([courseId, word])
  @@map("vocabulary")
}

model VocabularyReview {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyId    String
  vocabulary      Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  mastery         Int       @default(0) // 0-5
  seen            Int       @default(0)
  mistakes        Int       @default(0)
  correctAnswers  Int       @default(0)
  lastReviewed    DateTime?
  nextReview      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, vocabularyId])
  @@index([userId, nextReview])
  @@map("vocabulary_reviews")
}

// ===================== Subscriptions =====================

model Plan {
  id         String        @id @default(cuid())
  key        String        @unique // "FREE" | "PRO_MONTHLY" | "PRO_YEARLY"
  name       String
  priceCents Int           @default(0)
  currency   String        @default("USD")
  interval   PlanInterval?
  isActive   Boolean       @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

model UserInventory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey     String
  equipped    Boolean  @default(false)
  purchasedAt DateTime @default(now())

  @@unique([userId, itemKey])
  @@map("user_inventory")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}
