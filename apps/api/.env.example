DATABASE_URL="postgresql://kodo_dev:tu_password_local@127.0.0.1:5432/kodo_dev?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=genera_un_secreto_largo_y_aleatorio
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
SHADOW_DATABASE_URL="postgresql://kodo_dev:tu_password_local@127.0.0.1:5432/kodo_shadow?schema=public"
# Kill-switch for RUN exercises (executed via an isolated Docker container —
# see apps/api/src/execution/). Set to true only once Docker is confirmed
# working in that environment; false is always the safe default otherwise.
RUN_EXECUTION_ENABLED=false
# How many reverse-proxy hops sit in front of this process in production
# (usually 1). Leave unset for local dev — there's no proxy here. Never `true`.
# TRUST_PROXY=1
# Lemon Squeezy (Merchant of Record — Stripe doesn't support account
# creation from Colombia, this handles global tax/compliance for us).
# API key: app.lemonsqueezy.com > Settings > API.
# LEMONSQUEEZY_API_KEY=...
# Store ID: Settings > Stores.
# LEMONSQUEEZY_STORE_ID=...
# Signing secret set when creating the webhook (Settings > Webhooks),
# pointed at https://<your-api-domain>/subscriptions/webhook.
# LEMONSQUEEZY_WEBHOOK_SECRET=...
# Variant IDs for the two paid plans (Products > pick product > variant).
# LEMONSQUEEZY_VARIANT_PRO_MONTHLY=...
# LEMONSQUEEZY_VARIANT_PRO_YEARLY=...
# Where Lemon Squeezy's checkout redirects after a successful payment.
# FRONTEND_URL=http://localhost:3000
# Vercel Blob (subida de avatares) — pull from Vercel dashboard's Storage
# tab once the Blob store is connected, or via `vercel env pull` if this
# project is linked. Without it, POST /me/avatar/token responds 503
# instead of breaking boot (see avatar.service.ts).
# BLOB_READ_WRITE_TOKEN=...
